# Copy to `.env` and adjust. Both `docker compose` on the host and the auto-updater read this file.

# Port the game is published on (http://<host>:HOST_PORT).
HOST_PORT=8088

# Seconds between git checks. 0 disables auto-update.
UPDATE_INTERVAL=30

# Git remote/branch to follow. Empty branch = the branch currently checked out.
UPDATE_REMOTE=origin
UPDATE_BRANCH=
